# ─── Langfuse (dataset enrichment in scripts/langfuse_dataset.py) ────────
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...

# ─── Training model ──────────────────────────────────────────────────────
# HuggingFace model id (or local path) used by `python -m train`.
# Precedence: CLI flag `--model-name` > this env var > SFTConfig default
# (currently `unsloth/gemma-4-E4B-it-unsloth-bnb-4bit`). Useful to swap the base model
# without editing code, e.g. when running on a remote with a different
# pre-cached HF model.
TRAIN_MODEL_NAME=unsloth/gemma-4-E4B-it-unsloth-bnb-4bit

# ─── Weights & Biases (experiment tracking) ──────────────────────────────
# Used by `train/wandb_setup.py` when `--wandb` (or any `--wandb-*` CLI
# flag) is passed. ALL of these are also auto-forwarded to the remote
# host by `python -m train --remote` (see train/remote.py), so you only
# need to configure W&B once — locally, in this file.
#
# REQUIRED (only if you want telemetry):
#   Get yours from https://wandb.ai/authorize. Treat as a secret — `.env`
#   is gitignored by default. Without this, `wandb.init` runs in offline
#   mode (logs to disk only) and you'll get a one-line warning.
WANDB_API_KEY=
#
# OPTIONAL — sensible defaults shown:
#   Project name (anything, free-form). Created automatically on first run.
WANDB_PROJECT=agent-tuning
#   Entity = your W&B username, or a team. Leave empty to use your default.
WANDB_ENTITY=
#   Comma-separated run tags (e.g. "sft,gemma-4,baseline"). Useful for
#   dashboard filtering across many runs.
WANDB_TAGS=
#   Set to "offline" to skip the network round-trip (still writes a local
#   run dir under `outputs/<your-output-dir>/wandb/`). Set to "disabled"
#   to short-circuit wandb entirely without uninstalling it. See
#   https://docs.wandb.ai/guides/track/environment-variables.
WANDB_MODE=

# ─── Remote training over SSH ────────────────────────────────────────────
# Used by `python -m train --remote ...` (see train/remote.py).
# Leave SSH_REMOTE_HOST empty to force local-only execution.
#
# Required:
SSH_REMOTE_HOST=gpu-01.example.com
SSH_REMOTE_USER=ubuntu
#
# Optional — sensible defaults shown:
SSH_REMOTE_PORT=22
# Path to your private key. Leave empty to use the system ssh-agent
# / ~/.ssh/config defaults.
SSH_REMOTE_KEY_PATH=~/.ssh/id_ed25519
# SSH password (alternative to key auth — use ONLY if key auth is not
# available on the server). Requires the `sshpass` binary locally:
#   macOS  : brew install hudochenkov/sshpass/sshpass
#   Debian : sudo apt-get install sshpass
# WARNING: stored in plaintext in this file. Make sure `.env` stays in
# .gitignore (it is, by default) and is not shared. Prefer SSH keys when
# possible.
SSH_REMOTE_PASSWORD=
# Absolute (or ~-relative) directory on the remote host where the project
# tree is rsynced. It is created if missing.
SSH_REMOTE_WORKDIR=~/agent-tuning
# Python interpreter on the remote. Point to your venv's bin/python so we
# don't need to source-activate the env over a non-interactive ssh.
SSH_REMOTE_PYTHON=~/agent-tuning/.venv/bin/python
# Interpreter used to bootstrap the venv if SSH_REMOTE_PYTHON does not yet
# exist on the remote. Must be in PATH on the remote (e.g. /usr/bin/python3.12).
# Unsloth supports Python 3.10–3.12; pick one available on the host.
SSH_REMOTE_BOOTSTRAP_PYTHON=python3.12
# Optional shell snippet executed before the python call (joined with &&).
# Useful e.g. for conda environments:
#   SSH_REMOTE_PRE_COMMAND=source ~/miniconda3/etc/profile.d/conda.sh && conda activate train
SSH_REMOTE_PRE_COMMAND=
# Set to 0 if the dataset already lives on the remote (e.g. shared FS).
SSH_REMOTE_SYNC_DATASET=1
# Set to 0 to skip rsync-ing the LoRA adapter back to the local machine.
SSH_REMOTE_FETCH_OUTPUT=1
