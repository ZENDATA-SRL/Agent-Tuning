{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Benchmark: Ollama Gemma4:E2B + Azure Judge (smoke)",
            "type": "debugpy",
            "request": "launch",
            "module": "benchmark",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}",
            "args": [
                "--dataset",  "data/traces-2026-05-18.jsonl",
                "--backend",  "ollama",
                "--model",    "gemma4:e2b",
                "--base-url", "http://localhost:11434",
                "--temperature", "0.0",
                "--max-tokens",  "1024",
                "--max-traces",  "10",
                "--use-judge",
                "--judge-backend",    "azure",
                "--judge-model",      "${env:AZURE_OPENAI_MODEL}",
                "--judge-base-url",   "${env:AZURE_OPENAI_ENDPOINT}",
                "--judge-deployment", "${env:AZURE_OPENAI_MODEL}",
                "--judge-api-version","${env:AZURE_OPENAI_API_VERSION}",
                "--judge-temperature","0.0",
                "--judge-max-tokens", "512",
                "--output",   "results/debug_gemma4_e2b_smoke_judged.json"
            ]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}"
        }
    ]
}
